# TritonAI Developer API (LiteLLM, OpenAI-compatible). Server-side only.
# Get your key from https://tritonai-api.ucsd.edu/
TRITONAI_API_KEY=
TRITONAI_BASE_URL=https://tritonai-api.ucsd.edu/v1
TRITONAI_MODEL=api-gemma-4-31b
# Per-attempt AI call timeout. Timeouts are NOT retried (an identical prompt to an identical
# model times out again), so this is effectively the whole window one call gets. Sized to sit
# inside the routes' 60s maxDuration with room to answer and log.
AI_TIMEOUT_MS=50000
# Baseline synthesis reads the whole reference library, so it runs longer than the rest.
# Keep this under the route's maxDuration (60s) so the request always answers and logs.
AI_TIMEOUT_MS_SYNTHESIS=50000

# Per-feature model tiers. Each falls back to the tier below it, and finally to TRITONAI_MODEL.
# Pick per tier by what the workload can actually use, not by what is best overall.
#
# TRITONAI_MODEL_FAST       — tagging. Verbatim-grounded classification into a fixed enum, run
#                             while a human waits and confirmed by that human, so there is no
#                             capability headroom to buy. A small non-reasoning model is the
#                             right answer: no thinking tokens means no added latency on the
#                             app's only interactive model call.
# TRITONAI_MODEL_REASONING  — journey/blueprint/process/friction drafting, friction clustering,
#                             the briefing, and model-to-map (six routes, not three). This is
#                             the output the app AUTO-APPLIES rather than having a human approve
#                             item by item, so it is where model capability is worth paying for.
TRITONAI_MODEL_FAST=api-gemma-4-31b
TRITONAI_MODEL_REASONING=claude-sonnet-5

# TRITONAI_MODEL_SYNTHESIS  — baseline library synthesis only. Deliberately LEFT UNSET: it is
#                             grounded descriptive summarization and the client confirms every
#                             section before saving, so it needs no more model than drafting, and
#                             unset means it follows TRITONAI_MODEL_REASONING. Set it only when
#                             the reference library outgrows that model's context window — this
#                             is the one call that reads the whole library in a single shot.
TRITONAI_MODEL_SYNTHESIS=

# Embeddings model for the Reference Library's semantic retrieval. When unset, the library
# index and gap analysis fall back to keyword (lexical) retrieval — the feature works either
# way, embeddings just improve passage matching.
TRITONAI_MODEL_EMBED=api-tgpt-embeddings

# GitHub-as-storage. Fine-grained PAT scoped to THIS repo, Contents: read/write.
GITHUB_TOKEN=
GITHUB_REPO=z6johnson/ai-transformation
GITHUB_BRANCH=data

# Identity stamped on saved artifacts and the AI decision log.
PRACTICE_ACTOR=z6johnson@ucsd.edu
